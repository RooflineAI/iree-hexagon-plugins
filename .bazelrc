# Import IREE's own bazelrc for its build configs (generic_clang, opt, etc.)
# and flag aliases.
import %workspace%/third-party/iree/build_tools/bazel/iree.bazelrc

# Compiler selection and default config - see configured.bazelrc.
import %workspace%/configured.bazelrc

# Disable layering_check: the layering_check feature with clang module maps
# does not work correctly with bzlmod's repository name mangling (this repo
# embeds IREE as a non-root module), causing false "does not depend on a
# module exporting" errors.
build --features=-layering_check
build --host_features=-layering_check

# Enable fallback type IDs for MLIR to avoid issues with type ID registration
# across the dynamically-loaded compiler plugin shared libraries.
build --copt=-DMLIR_USE_FALLBACK_TYPE_IDS=1

# IREE's generic_clang config treats warnings as errors. clang-19 here is
# apparently stricter about a couple of warnings in vendored third-party
# sources than the upstream baseline, so demote those specific warnings back to
# non-fatal:
#  - deprecated-declarations: this system's glibc (2.39) marks mallinfo()
#    deprecated, which LLVM's Unix/Process.inc still calls as a fallback.
#  - implicit-fallthrough: vendored SPIRV-Cross has a couple of switch
#    fallthroughs without a [[fallthrough]] annotation.
build --copt=-Wno-error=deprecated-declarations
build --copt=-Wno-error=implicit-fallthrough

# Build only the local CPU runtimes and the Hexagon runtimes.
build --@iree//runtime/src/iree/hal/drivers:enabled_drivers=local-sync,local-task,hexagon

# Manylinux build: hermetic clang with glibc 2.28 pinned via the
# @llvm//constraints/libc:gnu.2.28 constraint on the platforms in //platform.
build:mlinux --platforms=//platform:mlinux_x86_64
build:mlinux --host_platform=//platform:linux_host
# libstdc++ headers emit -Wpass-failed=transform-warning when building LLVM
# source. Use .* to match + in Bazel canonical repo names.
build:mlinux --per_file_copt=external/.*llvm.project.*@-Wno-pass-failed
build:mlinux --per_file_copt=external/.*llvm.*gcc.*gcc.*/libstdc[+][+]-v3/.*@-Wno-unknown-attributes,-Wno-unknown-warning-option,-Wno-inline-namespace-reopened-noninline
build:mlinux --per_file_copt=external/.*llvm.*gcc.*gcc.*/libstdc[+][+]-v3/.*@-Wno-static-inline-explicit-instantiation,-Wno-character-conversion,-Wno-instantiation-after-specialization
build:mlinux --per_file_copt=external/.*llvm.*gcc.*gcc.*/libstdc[+][+]-v3/.*@-Wno-c++11-extensions,-Wno-implicit-exception-spec-mismatch,-Wno-string-plus-int
build:mlinux --per_file_copt=external/.*llvm.*gcc.*gcc.*/libstdcxx_generated/.*@-Wno-c++11-extensions

# The user.bazelrc file is not checked in but available for local mods.
# Always keep this at the end of the file so that user flags override.
try-import %workspace%/user.bazelrc

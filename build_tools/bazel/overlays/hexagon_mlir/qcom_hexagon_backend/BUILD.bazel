load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Hexagon runtime archive.
alias(
    name = "runtime_lib",
    actual = "@hexagon-mlir//qcom_hexagon_backend/bin/runtime:runtime_lib",
)

# Core Hexagon dialect/common implementation libraries required by registration
# and pass construction.
cc_library(
    name = "HexagonDialectLibs",
    deps = [
        "@hexagon-mlir//qcom_hexagon_backend/lib/Common:HexagonCommon",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Dialect/HexKL/IR:HexKL",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Dialect/HexKL/Transforms:HexKLTransforms",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Dialect/HexagonMem/IR:HexagonMem",
    ],
)

# Lowering/codegen support consumed by the plugin's CodeGen library.
cc_library(
    name = "HexagonLoweringSupport",
    deps = [
        ":HexagonDialectLibs",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Conversion/DMAToLLVM:DMAToLLVM",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Conversion/HexKLToLLVM:HexKLToLLVM",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Conversion/HexagonMemToLLVM:HexagonMemToLLVM",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Conversion/LinalgToLLVM:LinalgToLLVM",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Transforms:Transforms",
    ],
)

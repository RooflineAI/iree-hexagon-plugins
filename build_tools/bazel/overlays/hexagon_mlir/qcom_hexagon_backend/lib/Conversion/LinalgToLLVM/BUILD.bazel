load("@iree_hexagon_plugins//build_tools/bazel:defs.bzl", "hexagon_mlir_overlay_library")

package(default_visibility = ["//visibility:public"])

hexagon_mlir_overlay_library(
    name = "LinalgToLLVM",
    srcs = [
        "Common.cpp",
        "FormAsyncThreadsPass.cpp",
        "FormSCFThreads.cpp",
        "FormVirtualThreadsPass.cpp",
        "FusionPass.cpp",
        "HexmemCpyToDMA.cpp",
        "RewriteUBPoisonToZeroPass.cpp",
        "SlicingPass.cpp",
        "SplitReductionUtils.cpp",
        "TilingPass.cpp",
        "VTCMTiling.cpp",
        "VTCMTilingOptions.cpp",
        "VectorizationPass.cpp",
    ],
    copts = [
        # hexagon-mlir still uses deprecated IRRewriter::create APIs.
        "-Wno-deprecated-declarations",
        "-Wno-unused-but-set-variable",
        # Upstream contains mixed &&/|| conditions without explicit grouping.
        "-Wno-logical-op-parentheses",
    ],
    hdr_deps = [
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:AffineToStandard",
        "@llvm-project//mlir:AffineDialect",
        "@llvm-project//mlir:Analysis",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:ArithTransforms",
        "@llvm-project//mlir:ArithUtils",
        "@llvm-project//mlir:AsyncDialect",
        "@llvm-project//mlir:BufferizationDialect",
        "@llvm-project//mlir:BufferizationTransforms",
        "@llvm-project//mlir:ConversionPasses",
        "@llvm-project//mlir:DialectUtils",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LinalgDialect",
        "@llvm-project//mlir:LinalgTransforms",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:MathDialect",
        "@llvm-project//mlir:MemRefDialect",
        "@llvm-project//mlir:MemRefTransforms",
        "@llvm-project//mlir:MemRefUtils",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:SCFTransforms",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TensorDialect",
        "@llvm-project//mlir:TensorTransforms",
        "@llvm-project//mlir:TilingInterface",
        "@llvm-project//mlir:TransformDialectInterfaces",
        "@llvm-project//mlir:Transforms",
        "@llvm-project//mlir:UBDialect",
        "@llvm-project//mlir:VectorDialect",
    ],
    deps = [
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:ConversionHeadersLib",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:HexagonMemHeadersLib",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:TransformsHeadersLib",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Common:HexagonCommon",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Dialect/HexagonMem/IR:HexagonMem",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Transforms:Transforms",
    ],
)

# Host tools from IREE's vendored Tracy (third-party/iree/third_party/tracy),
# following its capture/ and csvexport/ CMake builds (cmake/server.cmake,
# cmake/vendor.cmake). No Tracy release speaks the protocol of this
# development snapshot, so the tools must be built from the same tree as the
# Tracy client in the runtime.

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

_CXXOPTS = [
    "-std=c++20",
    "-w",
] + select({
    # ppqsort uses std::jthread, which the NDK's libc++ only provides as an
    # experimental feature. tracy-capture and tracy-csvexport are built for
    # Android to capture and export on the device itself (see
    # integration_tests/stages/running.py).
    "@platforms//os:android": ["-fexperimental-library"],
    "//conditions:default": [],
})

# Tracy's cmake/GitRef.cmake fallback when git is unavailable; keeps the build
# hermetic. The tools still print the Tracy version next to it.
genrule(
    name = "gitref_hpp",
    outs = ["GitRef.hpp"],
    cmd = "printf '#pragma once\\nnamespace tracy { static inline const char* GitRef = \"unknown\"; }\\n' > $@",
)

cc_library(
    name = "gitref",
    hdrs = [":gitref_hpp"],
)

cc_library(
    name = "getopt",
    srcs = ["getopt/getopt.c"],
    hdrs = ["getopt/getopt.h"],
    copts = ["-w"],
)

# The statistics are left enabled (no TRACY_NO_STATISTICS): csvexport needs
# them, and capture works either way.
cc_library(
    name = "server",
    srcs = [
        "public/common/TracySocket.cpp",
        "public/common/TracyStackFrames.cpp",
        "public/common/TracySystem.cpp",
        "public/common/tracy_lz4.cpp",
        "public/common/tracy_lz4hc.cpp",
        "server/TracyBroadcast.cpp",
        "server/TracyLocks.cpp",
        "server/TracyMemory.cpp",
        "server/TracyMmap.cpp",
        "server/TracyPrint.cpp",
        "server/TracySysUtil.cpp",
        "server/TracyTaskDispatch.cpp",
        "server/TracyTextureCompression.cpp",
        "server/TracyThreadCompress.cpp",
        "server/TracyWorker.cpp",
    ],
    hdrs = glob([
        "public/common/*.hpp",
        "public/common/*.h",
        "server/*.hpp",
        "server/*.h",
    ]),
    copts = _CXXOPTS,
    # As TracyServer's target_include_directories in cmake/server.cmake.
    includes = [
        "public/common",
        "server",
    ],
    # Bionic has pthreads in libc and no libpthread.
    linkopts = select({
        "@platforms//os:android": [],
        "//conditions:default": ["-lpthread"],
    }),
    # tracy_lz4hc.cpp #includes tracy_lz4.cpp.
    textual_hdrs = ["public/common/tracy_lz4.cpp"],
    deps = [
        "@llvm_zstd//:zstd",
        "@tracy_capstone//:capstone",
        "@tracy_ppqsort//:ppqsort",
    ] + select({
        "@platforms//os:android": ["@@//build_tools/bazel/tracy:no_heap_pointer_tagging"],
        "//conditions:default": [],
    }),
)

# Capture helpers shared by tracy-capture and tracy-capture-daemon
# (cmake/util.cmake).
cc_library(
    name = "util",
    srcs = [
        "util/CaptureConsole.cpp",
        "util/CaptureFileBackup.cpp",
        "util/CaptureOutput.cpp",
    ],
    hdrs = glob(["util/*.hpp"]),
    copts = _CXXOPTS,
    includes = ["util"],
    deps = [":server"],
)

cc_binary(
    name = "tracy-capture",
    srcs = ["capture/src/capture.cpp"],
    copts = _CXXOPTS,
    deps = [
        ":getopt",
        ":gitref",
        ":server",
        ":util",
    ],
)

cc_binary(
    name = "tracy-csvexport",
    srcs = ["csvexport/src/csvexport.cpp"],
    copts = _CXXOPTS,
    deps = [
        ":getopt",
        ":gitref",
        ":server",
    ],
)

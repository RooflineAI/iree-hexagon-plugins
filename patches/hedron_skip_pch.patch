@@ -614,6 +614,16 @@
     """Gets the ({source files}, {header files}) clangd should be told the command applies to."""
 
     # Getting the source file is a little trickier than it might seem.
+
+    # Bazel's parse_headers feature emits -xc++-header actions with only a
+    # header input. Hedron finds no recognized source extension and otherwise
+    # fails its source_file_candidates assertion. These actions are not useful
+    # in compile_commands.json, so skip them. Remove this workaround once the
+    # upstream fix lands:
+    # https://github.com/hedronvision/bazel-compile-commands-extractor/pull/262
+    if '-xc++-header' in compile_action.arguments:
+        return set(), set()
+
 
     # First, we do the obvious thing: Filter args to those that look like source files.
     source_file_candidates = [arg for arg in compile_action.arguments if not arg.startswith('-') and arg.endswith(_get_files.source_extensions)]

+
+int hexkl_matmul_f16f16_f32_with_scratch(uint64_t n_row, uint64_t n_col,
+                                         uint64_t n_inner, float *restrict outM,
+                                         const _Float16 *restrict inAct,
+                                         const _Float16 *restrict inW,

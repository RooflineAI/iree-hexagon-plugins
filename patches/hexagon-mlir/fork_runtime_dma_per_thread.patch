diff --git a/qcom_hexagon_backend/bin/runtime/UserDMA/RuntimeDMA.cc b/qcom_hexagon_backend/bin/runtime/UserDMA/RuntimeDMA.cc
index 987a7dc..7e94ffd 100644
--- a/qcom_hexagon_backend/bin/runtime/UserDMA/RuntimeDMA.cc
+++ b/qcom_hexagon_backend/bin/runtime/UserDMA/RuntimeDMA.cc
@@ -23,15 +23,42 @@
 //===----------------------------------------------------------------------===//
 
 #include "RuntimeDMA.h"
+#include "HexagonCommon.h"
 #include "UserDMA.h"
+#include "qurt.h"
 
 namespace hexagon {
 namespace userdma {
 
-// Create a static object of HexagonUserDMA to be used in DMAStart and
-// DMAWait APIs. TODO: Make HexagonUserDMA class as a singleton and
-// call its static member function to get its unique instance
-static UserDMA hexDMA(hexagon::userdma::MAX_NUM_DMA_DESCRIPTORS);
+// Fork divergence note
+// Avoid relying on global static C++ constructor execution when this code is
+// linked into generated kernel shared objects.
+// Each thread gets its own UserDMA: a shared one is not thread-safe (its
+// descriptor chain and ring buffer are updated without locking), and the
+// runtime executes dispatches concurrently on several threads. DMA tokens are
+// therefore only valid on the thread that issued them.
+static void destroyDMA(void *dma) { delete static_cast<UserDMA *>(dma); }
+
+static int getDMAKey() {
+  static int key = [] {
+    int k;
+    CHECK(qurt_tls_create_key(&k, destroyDMA) == QURT_EOK,
+          "UserDMA: no free TLS key");
+    return k;
+  }();
+  return key;
+}
+
+static UserDMA *getDMA() {
+  int key = getDMAKey();
+  UserDMA *dma = static_cast<UserDMA *>(qurt_tls_get_specific(key));
+  if (!dma) {
+    dma = new UserDMA(hexagon::userdma::MAX_NUM_DMA_DESCRIPTORS);
+    CHECK(qurt_tls_set_specific(key, dma) == QURT_EOK,
+          "UserDMA: failed to store the per-thread instance");
+  }
+  return dma;
+}
 
 /*!
  * Initiate DMA to copy memory from source to destination address
@@ -48,8 +75,8 @@ extern "C" uint32_t
 hexagon_runtime_dma_start(void *src, AddrSpace srcAS, void *dst,
                           AddrSpace dstAS, uint32_t length, bool bypassCacheSrc,
                           bool bypassCacheDst, DMAStatus *status) {
-  return hexDMA.copy(src, srcAS, dst, dstAS, length, bypassCacheSrc,
-                     bypassCacheDst, status);
+  return getDMA()->copy(src, srcAS, dst, dstAS, length, bypassCacheSrc,
+                        bypassCacheDst, status);
 }
 

diff --git a/build_tools/bazel/BUILD.bazel b/build_tools/bazel/BUILD.bazel
index 7d870c75f8..aa87eec872 100644
--- a/build_tools/bazel/BUILD.bazel
+++ b/build_tools/bazel/BUILD.bazel
@@ -33,6 +33,20 @@ config_setting(
     },
 )
 
+# Detect Android from platform OS setting.
+# Note: Upstream IREE uses a define "iree_is_android" (see above) for building
+# iree-run-module for Android. This repo builds for Android via a platform OS
+# ("//platform:aarch64_android"), which is also used to pick the right
+# toolchain. When building for this platform OS, this needs to also trigger
+# the same config adaptions as "iree_is_android" for IREE. So define a config
+# setting triggering on the platform OS.
+config_setting(
+    name = "iree_is_android_platform_os",
+    constraint_values = [
+        "@platforms//os:android",
+    ],
+)
+
 # OS platform constraints. Used in select() for platform-specific backend
 # selection. bazel_to_cmake maps these to CMAKE_SYSTEM_NAME checks.
 config_setting(

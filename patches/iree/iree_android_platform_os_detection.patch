@@ -71,6 +71,12 @@ iree_runtime_cc_library(
         "//build_tools/bazel:iree_is_android": [
             "//runtime/src/iree/async/platform/linux:signal",
         ],
+        # This repo builds for Android via a platform OS rather than the
+        # define-based iree_is_android, so the signalfd backend is selected
+        # and needs the same linux signal dep (see iree_is_android_platform_os).
+        "//build_tools/bazel:iree_is_android_platform_os": [
+            "//runtime/src/iree/async/platform/linux:signal",
+        ],
         "//conditions:default": [],
     }),
 )

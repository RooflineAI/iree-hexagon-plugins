diff --git a/compiler/src/iree/compiler/Dialect/HAL/Transforms/test/materialize_interfaces.mlir b/compiler/src/iree/compiler/Dialect/HAL/Transforms/test/materialize_interfaces.mlir
index 28401e6009..7f4dca2445 100644
--- a/compiler/src/iree/compiler/Dialect/HAL/Transforms/test/materialize_interfaces.mlir
+++ b/compiler/src/iree/compiler/Dialect/HAL/Transforms/test/materialize_interfaces.mlir
@@ -248,3 +248,49 @@ module {
     util.return %0 : !stream.timepoint
   }
 }
+
+// -----
+
+// Tests that a binding is Constant only if every dispatch site binds an
+// immutable global and the binding is only read: binding 1 is a transient at
+// one site and a mutable global at the other, binding 2 is written.
+
+util.global private @default_device = #hal.device.target<"cpu", [
+  #hal.executable.target<"llvm-cpu", "arm_64">
+]> : !hal.device
+util.global private @immutable : !stream.resource<constant>
+util.global private mutable @mutable : !stream.resource<variable>
+
+// CHECK: #pipeline_layout = #hal.pipeline.layout<
+// CHECK-SAME: bindings = [
+// CHECK-SAME:   #hal.pipeline.binding<storage_buffer, "ReadOnly|Constant">
+// CHECK-SAME:   #hal.pipeline.binding<storage_buffer, ReadOnly>
+// CHECK-SAME:   #hal.pipeline.binding<storage_buffer>
+stream.executable private @ex {
+  stream.executable.export public @entry
+  builtin.module {
+    func.func @entry(%arg0: !stream.binding, %arg1: !stream.binding, %arg2: !stream.binding) {
+      return
+    }
+  }
+}
+util.func public @main(%arg0: !stream.resource<transient>, %arg1: index) attributes {
+  stream.affinity = #hal.device.affinity<@default_device>
+} {
+  %c0 = arith.constant 0 : index
+  %immutable = util.global.load immutable @immutable : !stream.resource<constant>
+  %mutable = util.global.load @mutable : !stream.resource<variable>
+  %0 = stream.cmd.execute once with(%immutable as %arg2: !stream.resource<constant>{%arg1}, %mutable as %arg3: !stream.resource<variable>{%arg1}, %arg0 as %arg4: !stream.resource<transient>{%arg1}) {
+    stream.cmd.dispatch @ex::@entry {
+      ro %arg2[%c0 for %arg1] : !stream.resource<constant>{%arg1},
+      ro %arg4[%c0 for %arg1] : !stream.resource<transient>{%arg1},
+      wo %arg2[%c0 for %arg1] : !stream.resource<constant>{%arg1}
+    }
+    stream.cmd.dispatch @ex::@entry {
+      ro %arg2[%c0 for %arg1] : !stream.resource<constant>{%arg1},
+      ro %arg3[%c0 for %arg1] : !stream.resource<variable>{%arg1},
+      wo %arg2[%c0 for %arg1] : !stream.resource<constant>{%arg1}
+    }
+  } => !stream.timepoint
+  util.return
+}

@@ -169,10 +169,33 @@ void iree_tracing_gpu_zone_begin_external(
     uint8_t context_id, uint16_t query_id, const char* file_name,
     size_t file_name_length, uint32_t line, const char* function_name,
     size_t function_name_length, const char* name, size_t name_length);
+// Same as iree_tracing_gpu_zone_begin_external, with the zone drawn in
+// |color_xbgr| (0 selects the default color).
+void iree_tracing_gpu_zone_begin_external_colored(
+    uint8_t context_id, uint16_t query_id, const char* file_name,
+    size_t file_name_length, uint32_t line, const char* function_name,
+    size_t function_name_length, const char* name, size_t name_length,
+    uint32_t color_xbgr);
 void iree_tracing_gpu_zone_end(uint8_t context_id, uint16_t query_id);
 void iree_tracing_gpu_zone_notify(uint8_t context_id, uint16_t query_id,
                                   int64_t gpu_timestamp);
 
+// Names the annotation |annotation_id| of GPU context |context_id|. Tracy keeps
+// one name per annotation ID and context for the whole capture: the last name
+// sent wins, and it also applies to values attached earlier.
+void iree_tracing_gpu_context_annotation_name(uint8_t context_id,
+                                              int64_t annotation_id,
+                                              const char* name,
+                                              size_t name_length);
+// Attaches |value| as annotation |annotation_id| to the GPU zone that began
+// with |query_id|, e.g. a hardware counter measured over the zone. Tracy keys
+// annotation values by context and query ID for the whole capture, so values
+// are only attributed to a single zone if its query ID is not reused within
+// the context; zones that share a query ID all show the last value attached
+// for each annotation ID.
+void iree_tracing_gpu_zone_annotation(uint8_t context_id, uint16_t query_id,
+                                      int64_t annotation_id, double value);
+
 #endif  // IREE_TRACING_FEATURE_INSTRUMENTATION_DEVICE
 
 #if IREE_TRACING_FEATURES & IREE_TRACING_FEATURE_ALLOCATION_TRACKING

+      WideInOpVT.getVectorNumElements() > WidenInVT.getVectorNumElements()) {
+    SDLoc dl(N);
+    EVT WideResVT =
+        EVT::getVectorVT(*DAG.getContext(), WidenVT.getVectorElementType(),
+                         WideInOpVT.getVectorElementCount());

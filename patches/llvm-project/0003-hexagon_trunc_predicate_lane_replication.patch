 def Q2V: OutPatFrag<(ops node:$Qs), (V6_vandqrt $Qs, (ToI32 -1))>;
 
+// A predicate has one physical bit per byte. Truncating a halfword or word
+// to i1 must replicate its low bit across all bytes of that element. A
+// byte-wise vand predicate would instead test the low bit of each byte.
+def TruncH2Q: OutPatFrag<(ops node:$Vs),
+  (V6_veqh (V6_vand $Vs, (PS_vsplatiw (i32 65537))),
+           (PS_vsplatiw (i32 65537)))>;
+def TruncW2Q: OutPatFrag<(ops node:$Vs),
+  (V6_veqw (V6_vand $Vs, (PS_vsplatiw (i32 1))),
+           (PS_vsplatiw (i32 1)))>;
+
 def Combinev: OutPatFrag<(ops node:$Vs, node:$Vt),
   (REG_SEQUENCE HvxWR, $Vs, vsub_hi, $Vt, vsub_lo)>;
 
@@ -771,15 +781,15 @@ let Predicates = [UseHVX] in {
   def: Pat<(VecQ8 (trunc HVI8:$Vs)),
            (V6_vandvrt HvxVR:$Vs, (ToI32 0x01010101))>;
   def: Pat<(VecQ16 (trunc HVI16:$Vs)),
-           (V6_vandvrt HvxVR:$Vs, (ToI32 0x01010101))>;
+           (TruncH2Q HvxVR:$Vs)>;
   def: Pat<(VecQ32 (trunc HVI32:$Vs)),
-           (V6_vandvrt HvxVR:$Vs, (ToI32 0x01010101))>;
+           (TruncW2Q HvxVR:$Vs)>;
   def: Pat<(VecQ8 (trunc HWI16:$Vss)),
-           (Combineq(VecQ16(V6_vandvrt (HiVec $Vss), (ToI32 0x01010101))),
-           (VecQ16 (V6_vandvrt (LoVec $Vss), (ToI32 0x01010101))))>;
+           (Combineq (VecQ16 (TruncH2Q (HiVec $Vss))),
+                     (VecQ16 (TruncH2Q (LoVec $Vss))))>;
   def: Pat<(VecQ16 (trunc HWI32:$Vss)),
-           (Combineq(VecQ32(V6_vandvrt (HiVec $Vss), (ToI32 0x01010101))),
-           (VecQ32 (V6_vandvrt (LoVec $Vss), (ToI32 0x01010101))))>;
+           (Combineq (VecQ32 (TruncW2Q (HiVec $Vss))),
+                     (VecQ32 (TruncW2Q (LoVec $Vss))))>;
 }
 

diff --git a/llvm/test/CodeGen/Hexagon/isel/trunc-predicate-select.ll b/llvm/test/CodeGen/Hexagon/isel/trunc-predicate-select.ll
new file mode 100644
index 000000000000..ceedc53eab56
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/isel/trunc-predicate-select.ll
@@ -0,0 +1,70 @@
+; RUN: llc -mtriple=hexagon -mcpu=hexagonv79 -mattr=+hvxv79,+hvx-length128b -verify-machineinstrs < %s | FileCheck %s
+;
+; Truncating to i1 tests the integer element's low bit. HVX predicates have
+; one physical bit per byte, so halfword/word predicates must replicate that
+; bit before selecting data. Byte-wise vand is insufficient: for a word 1 it
+; sets only the first of four predicate bits and creates a mixed-byte result.
+; The narrow byte load also exercises legalization through word-sized lanes.
+
+; CHECK-LABEL: select_byte_mask:
+; CHECK: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.w,v{{[0-9]+}}.w)
+; CHECK: vmux
+define void @select_byte_mask(ptr %mask, ptr %yes, ptr %no, ptr %out) {
+  %m = load <32 x i8>, ptr %mask, align 1
+  %p = trunc <32 x i8> %m to <32 x i1>
+  %a = load <32 x float>, ptr %yes, align 128
+  %b = load <32 x float>, ptr %no, align 128
+  %r = select <32 x i1> %p, <32 x float> %a, <32 x float> %b
+  store <32 x float> %r, ptr %out, align 128
+  ret void
+}
+
+; CHECK-LABEL: select_halfword_mask:
+; CHECK: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.h,v{{[0-9]+}}.h)
+; CHECK: vmux
+define void @select_halfword_mask(<64 x i16> %m, ptr %yes, ptr %no, ptr %out) {
+  %p = trunc <64 x i16> %m to <64 x i1>
+  %a = load <64 x i16>, ptr %yes, align 128
+  %b = load <64 x i16>, ptr %no, align 128
+  %r = select <64 x i1> %p, <64 x i16> %a, <64 x i16> %b
+  store <64 x i16> %r, ptr %out, align 128
+  ret void
+}
+
+; CHECK-LABEL: select_word_mask:
+; CHECK: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.w,v{{[0-9]+}}.w)
+; CHECK: vmux
+define void @select_word_mask(<32 x i32> %m, ptr %yes, ptr %no, ptr %out) {
+  %p = trunc <32 x i32> %m to <32 x i1>
+  %a = load <32 x float>, ptr %yes, align 128
+  %b = load <32 x float>, ptr %no, align 128
+  %r = select <32 x i1> %p, <32 x float> %a, <32 x float> %b
+  store <32 x float> %r, ptr %out, align 128
+  ret void
+}
+
+; CHECK-LABEL: select_word_pair_mask:
+; CHECK-DAG: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.w,v{{[0-9]+}}.w)
+; CHECK-DAG: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.w,v{{[0-9]+}}.w)
+; CHECK: vmux
+define void @select_word_pair_mask(<64 x i32> %m, ptr %yes, ptr %no, ptr %out) {
+  %p = trunc <64 x i32> %m to <64 x i1>
+  %a = load <64 x i16>, ptr %yes, align 128
+  %b = load <64 x i16>, ptr %no, align 128
+  %r = select <64 x i1> %p, <64 x i16> %a, <64 x i16> %b
+  store <64 x i16> %r, ptr %out, align 128
+  ret void
+}
+
+; CHECK-LABEL: select_halfword_pair_mask:
+; CHECK-DAG: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.h,v{{[0-9]+}}.h)
+; CHECK-DAG: q{{[0-9]+}} = vcmp.eq(v{{[0-9]+}}.h,v{{[0-9]+}}.h)
+; CHECK: vmux
+define void @select_halfword_pair_mask(<128 x i16> %m, ptr %yes, ptr %no, ptr %out) {
+  %p = trunc <128 x i16> %m to <128 x i1>
+  %a = load <128 x i8>, ptr %yes, align 128
+  %b = load <128 x i8>, ptr %no, align 128
+  %r = select <128 x i1> %p, <128 x i8> %a, <128 x i8> %b
+  store <128 x i8> %r, ptr %out, align 128
+  ret void
+}

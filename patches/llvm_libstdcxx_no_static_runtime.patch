+++ b/toolchain/BUILD.bazel
@@ -224,6 +224,18 @@ cc_args_list(
     }),
 )
 
+# link libstdc++ dynamically on all libstdcxx_linux platforms and source
+# _Unwind_* from a soname-compat hermetic libgcc_s (never the toolchain-private
+# libunwind.so.1, which is absent on target boards), for both executables and
+# shared libraries and every mlinux arch. See //toolchain/args:libstdcxx_link_flags.
+cc_args_list(
+    name = "libstdcxx_link_flags",
+    args = select({
+        "@llvm//runtimes/cxxstdlib:libstdcxx_linux": ["//toolchain/args:libstdcxx_link_flags"],
+        "//conditions:default": [],
+    }),
+)
+
 # This makes the clang driver use compiler-rt compliant filenames
 # and paths when resolving compiler runtime libraries from the resource-dir.
 cc_args_list(
@@ -338,6 +350,7 @@ cc_args_list(
         ":libunwind_library_search_paths",
         ":rtlib",
         ":stdlib",
+        ":libstdcxx_link_flags",
         ":unwindlib",
         ":resource_dir",
         "//toolchain/args:validate_static_library_args",
diff --git a/toolchain/args/BUILD.bazel b/toolchain/args/BUILD.bazel
index d6ba4e4..42771a7 100644
--- a/toolchain/args/BUILD.bazel
+++ b/toolchain/args/BUILD.bazel
@@ -876,6 +876,29 @@ cc_args(
     ],
 )
 
+cc_args(
+    # libstdcxx links, all mlinux arches, executables and shared libraries:
+    # resolve C++ stdlib symbols via libstdc++.so and _Unwind_* via a hermetic
+    # libunwind rebuilt with soname libgcc_s.so.1. That compat lib is staged in
+    # the toolchain library search directory and linked by exact name
+    # (-l:libgcc_s.so.1) so resolution rides the same uniformly-staged search
+    # path as -lunwind, which works for cc_binary, cc_shared_library, and
+    # rules_go cgo host tools alike (a direct generated-file arg does not:
+    # rules_go threads an inconsistent config path for it). _Unwind_* resolve at
+    # link time (so -Wl,--no-undefined and lld's default
+    # --no-allow-shlib-undefined executable check pass) while the artifact
+    # records NEEDED libgcc_s.so.1, present on every glibc target next to
+    # libstdc++.so.6. The compat lib is link-time only, never shipped: at load
+    # time the single system libgcc_s binds, so nothing needs libunwind.so.1 and
+    # there is no PyTorch/ONNX dual-unwinder crash.
+    name = "libstdcxx_link_flags",
+    actions = [
+        "@rules_cc//cc/toolchains/actions:link_executable_actions",
+        "@rules_cc//cc/toolchains/actions:dynamic_library_link_actions",
+    ],
+    args = ["-lstdc++", "-l:libgcc_s.so.1"],
+)
+
 cc_args(
     name = "unwindlib_none",
     actions = [

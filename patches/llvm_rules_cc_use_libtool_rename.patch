Adapt the hermetic LLVM toolchain (llvm@0.8.3) to rules_cc >= 0.2.19, which
renamed the archiver config_setting use_libtool_on_macos_setting ->
use_libtool_on_apple_setting. Our module graph resolves rules_cc to 0.2.19
(forced by abseil-cpp/iree_core/rules_rust/... via MVS), so the pre-rename
target no longer exists. The branch only matters on Apple hosts; on Linux it is
the unselected arm of the select, but the key must still resolve at analysis.

diff --git a/toolchain/selects.bzl b/toolchain/selects.bzl
--- a/toolchain/selects.bzl
+++ b/toolchain/selects.bzl
@@ -63,5 +63,5 @@
     # See https://github.com/bazelbuild/bazel/issues/27623#issuecomment-3529439585 for more details.
     return select({
-        "@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_macos_setting": tool_repo + ":tools_with_libtool",
+        "@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_apple_setting": tool_repo + ":tools_with_libtool",
         "//conditions:default": tool_repo + ":default_tools",
     })
diff --git a/toolchain/bootstrap/declare_toolchains.bzl b/toolchain/bootstrap/declare_toolchains.bzl
--- a/toolchain/bootstrap/declare_toolchains.bzl
+++ b/toolchain/bootstrap/declare_toolchains.bzl
@@ -300,5 +300,5 @@
             name = cc_toolchain_name,
             tool_map = select({
-                "@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_macos_setting": ":{}_{}/tools_with_libtool".format(exec_os, exec_cpu),
+                "@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_apple_setting": ":{}_{}/tools_with_libtool".format(exec_os, exec_cpu),
                 "//conditions:default": ":{}_{}/default_tools".format(exec_os, exec_cpu),
             }),

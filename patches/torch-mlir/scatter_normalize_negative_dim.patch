+
+// -----
+
+// A negative dim must select the same dimension as its positive equivalent
+// (here 1): the scatter index replaces the second coordinate of each update.
+// CHECK-LABEL: @scatter_src_negative_dim
+// CHECK:         %[[IDX:.*]] = tensor.extract %{{.*}} : tensor<2x3xi64>
+// CHECK:         %[[SRC:.*]] = tensor.extract %{{.*}} : tensor<2x3xf32>
+// CHECK:         %[[ROW:.*]] = arith.index_cast %{{.*}} : index to i64
+// CHECK:         linalg.yield %[[ROW]], %[[IDX]], %[[SRC]] : i64, i64, f32
+// CHECK:       tm_tensor.scatter {dimension_map = array<i64: 0, 1>} unique_indices(false) ins(%{{.*}}, %{{.*}} : tensor<?xf32>, tensor<?x2xi64>) outs(%{{.*}} : tensor<2x8xf32>) {
+func.func @scatter_src_negative_dim(%arg0: !torch.vtensor<[2,8],f32>, %arg1: !torch.vtensor<[2,3],si64>, %arg2: !torch.vtensor<[2,3],f32>) -> !torch.vtensor<[2,8],f32> {
+  %int-1 = torch.constant.int -1
+  %0 = torch.aten.scatter.src %arg0, %int-1, %arg1, %arg2 : !torch.vtensor<[2,8],f32>, !torch.int, !torch.vtensor<[2,3],si64>, !torch.vtensor<[2,3],f32> -> !torch.vtensor<[2,8],f32>
+  return %0 : !torch.vtensor<[2,8],f32>
+}
+

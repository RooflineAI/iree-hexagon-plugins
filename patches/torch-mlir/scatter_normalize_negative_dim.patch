+// CHECK:         arith.addf
+func.func @scatter_add_negative_dim(%arg0: !torch.vtensor<[2,8],f32>, %arg1: !torch.vtensor<[2,3],si64>, %arg2: !torch.vtensor<[2,3],f32>) -> !torch.vtensor<[2,8],f32> {

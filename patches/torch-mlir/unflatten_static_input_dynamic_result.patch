diff --git a/lib/Conversion/TorchToLinalg/DataMovement.cpp b/lib/Conversion/TorchToLinalg/DataMovement.cpp
index fa849956..3ad3f8bf 100644
--- a/lib/Conversion/TorchToLinalg/DataMovement.cpp
+++ b/lib/Conversion/TorchToLinalg/DataMovement.cpp
@@ -729,6 +729,35 @@ public:
 
     outputSizes = expandTy.getShape();
 
+    // tensor.expand_shape requires a static input dim to expand into static
+    // result dims only, and its builder that infers the output shape crashes
+    // otherwise. Torch shape inference can still leave such a result dim
+    // unknown, e.g. tensor<52xf32> unflattened into tensor<1x1x?x1xf32>.
+    // Compute those dims from the static input dim. The expand_shape below
+    // then produces this refined type, which is cast back to expandTy.
+    ArrayRef<int64_t> inputSizes = inputTy.getShape();
+    SmallVector<int64_t> refinedOutputSizes(outputSizes);
+    for (int64_t i = 0; i < outputRank; ++i) {
+      if (!ShapedType::isDynamic(refinedOutputSizes[i]))
+        continue;
+      if (i < dimInt || i >= dimInt + numSizes) {
+        refinedOutputSizes[i] = inputSizes[i < dimInt ? i : i - numSizes + 1];
+        continue;
+      }
+      if (ShapedType::isDynamic(inputSizes[dimInt]) ||
+          numDynamicReassocDims != 1)
+        continue;
+      int64_t staticProduct = 1;
+      for (int64_t j = dimInt; j < dimInt + numSizes; ++j)
+        if (j != i)
+          staticProduct *= outputSizes[j];
+      if (staticProduct == 0 || inputSizes[dimInt] % staticProduct != 0)
+        return rewriter.notifyMatchFailure(
+            op, "unflattened sizes do not divide the input dim");
+      refinedOutputSizes[i] = inputSizes[dimInt] / staticProduct;
+    }
+    auto refinedExpandTy = expandTy.clone(refinedOutputSizes);
+
     if (!inputAllStatic && outputAllStatic) {
       // The output tensor type is all static, but the input tensor type is not.
       // Construct input with static shapes.
@@ -772,9 +801,11 @@ public:
         for (int i = dimInt + numSizes; i < outputRank; ++i)
           reassociations[i - numSizes + 1].push_back(i);
       }
-      expand = tensor::ExpandShapeOp::create(rewriter, loc, expandTy, self,
-                                             reassociations)
+      expand = tensor::ExpandShapeOp::create(rewriter, loc, refinedExpandTy,
+                                             self, reassociations)
                    .getResult();
+      if (refinedExpandTy != expandTy)
+        expand = tensor::CastOp::create(rewriter, loc, expandTy, expand);
     } else {
       reassocSizes = getTypeConvertedValues(rewriter, loc, getTypeConverter(),
                                             reassocSizes);

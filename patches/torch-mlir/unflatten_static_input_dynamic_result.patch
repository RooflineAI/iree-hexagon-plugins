+// CHECK:           %[[IN:.*]] = torch_c.to_builtin_tensor %{{.*}} : !torch.vtensor<[4,12],f32> -> tensor<4x12xf32>
+// CHECK:           %[[EXP:.*]] = tensor.expand_shape %[[IN]] {{\[\[}}0], [1, 2]] output_shape [4, 3, 4] : tensor<4x12xf32> into tensor<4x3x4xf32>
+// CHECK:           %[[CAST:.*]] = tensor.cast %[[EXP]] : tensor<4x3x4xf32> to tensor<?x3x?xf32>
+// CHECK:           %[[OUT:.*]] = torch_c.from_builtin_tensor %[[CAST]] : tensor<?x3x?xf32> -> !torch.vtensor<[?,3,?],f32>
+// CHECK:           return %[[OUT]] : !torch.vtensor<[?,3,?],f32>
+func.func @aten.unflatten.int$static_input_dynamic_outer_dim(%arg0: !torch.vtensor<[4,12],f32>) -> !torch.vtensor<[?,3,?],f32> {
+  %int1 = torch.constant.int 1
+  %int3 = torch.constant.int 3
+  %int-1 = torch.constant.int -1
+  %0 = torch.prim.ListConstruct %int3, %int-1 : (!torch.int, !torch.int) -> !torch.list<int>
+  %1 = torch.aten.unflatten.int %arg0, %int1, %0 : !torch.vtensor<[4,12],f32>, !torch.int, !torch.list<int> -> !torch.vtensor<[?,3,?],f32>
+  return %1 : !torch.vtensor<[?,3,?],f32>
+}

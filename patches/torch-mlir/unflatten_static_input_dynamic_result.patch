 // -----
 
+// A static source dim expanded into a group with a dynamic result dim. This
+// used to crash in tensor::ExpandShapeOp's output-shape inference. The
+// dynamic dim is computed statically (52) and cast back to the result type.
+// CHECK-LABEL:   func.func @aten.unflatten.int$static_input_dynamic_group(
+// CHECK:           %[[IN:.*]] = torch_c.to_builtin_tensor %{{.*}} : !torch.vtensor<[52],f32> -> tensor<52xf32>
+// CHECK:           %[[EXP:.*]] = tensor.expand_shape %[[IN]] {{\[\[}}0, 1, 2, 3]] output_shape [1, 1, 52, 1] : tensor<52xf32> into tensor<1x1x52x1xf32>
+// CHECK:           %[[CAST:.*]] = tensor.cast %[[EXP]] : tensor<1x1x52x1xf32> to tensor<1x1x?x1xf32>
+// CHECK:           %[[OUT:.*]] = torch_c.from_builtin_tensor %[[CAST]] : tensor<1x1x?x1xf32> -> !torch.vtensor<[1,1,?,1],f32>
+// CHECK:           return %[[OUT]] : !torch.vtensor<[1,1,?,1],f32>
+func.func @aten.unflatten.int$static_input_dynamic_group(%arg0: !torch.vtensor<[52],f32>) -> !torch.vtensor<[1,1,?,1],f32> {
+  %int0 = torch.constant.int 0
+  %int1 = torch.constant.int 1
+  %int-1 = torch.constant.int -1
+  %0 = torch.prim.ListConstruct %int1, %int1, %int-1, %int1 : (!torch.int, !torch.int, !torch.int, !torch.int) -> !torch.list<int>
+  %1 = torch.aten.unflatten.int %arg0, %int0, %0 : !torch.vtensor<[52],f32>, !torch.int, !torch.list<int> -> !torch.vtensor<[1,1,?,1],f32>
+  return %1 : !torch.vtensor<[1,1,?,1],f32>
+}
+
+// -----
+
+// A static source dim outside the unflattened group whose result dim is
+// dynamic. Same crash, through a single-dim reassociation group.

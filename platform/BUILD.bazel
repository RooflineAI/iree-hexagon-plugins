package(default_visibility = ["//visibility:public"])

# Target platform for the Android aarch64 host side of the hexagon runtime
# plugin (the ARM side talking to the DSP over FastRPC).
platform(
    name = "aarch64_android",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

# Target platform for the Hexagon DSP side of the runtime plugin.
platform(
    name = "hexagon",
    constraint_values = [
        "//constraints:cpu_hexagon",
        "//constraints:os_qurt",
    ],
)

# Host (exec) platform for --config=mlinux. The libc constraint pins the
# hermetic-llvm toolchain to glibc 2.28 instead of its "earliest glibc
# supporting the target" default, so the floor cannot drift on toolchain
# upgrades. Exec tools use the hermetic static libc++ (no libstdcxx constraint).
platform(
    name = "linux_host",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
    ],
)

# Target platform for the released x86_64 Linux host tools (--config=mlinux).
# Declares libstdc++ so the toolchain links the system libstdc++.so.6 (and
# libgcc_s.so.1) dynamically instead of embedding libc++; the
# llvm_libstdcxx_no_static_runtime patch keys off this constraint.
platform(
    name = "mlinux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
        "@llvm//constraints/cxxstdlib:libstdcxx",
    ],
)

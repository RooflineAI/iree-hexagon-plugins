load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")

package(
    default_visibility = ["//visibility:public"],
)

RPATH_LINKOPTS = select({
    "@platforms//os:linux": ["-Wl,-rpath,$ORIGIN"],
    "@platforms//os:osx": ["-Wl,-rpath,@loader_path"],
    "//conditions:default": [],
})

cc_import(
    name = "IREECompilerLibImport",
    shared_library = "@iree//lib:IREECompilerUnshielded",
)

cc_binary(
    name = "cellar_hexagon_compiler_plugin",
    srcs = [],
    linkopts = RPATH_LINKOPTS,
    linkshared = True,
    deps = [
        ":IREECompilerLibImport",
        "//plugins/compiler/cellar-hexagon:registration",
        "//plugins/compiler/cellar-hexagon/CodeGen:HexagonEncodingExternalModels",
        "//plugins/compiler/cellar-hexagon/CodeGen:codegen",
        "//plugins/compiler/cellar-hexagon/CodeGen/IR:HexagonIR",
        "//plugins/compiler/cellar-hexagon/Target:HexagonSession",
        "//plugins/compiler/cellar-hexagon/Target/Linking:HexagonLinkerTool",
    ],
)

load(
    "@iree//build_tools/bazel:build_defs.oss.bzl",
    "iree_gentbl_cc_library",
    "iree_td_library",
)
load("//build_tools/bazel:defs.bzl", "cellar_hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_td_library(
    name = "hexagon_td_files",
    srcs = [
        "HexagonAttrs.td",
        "HexagonDialect.td",
        "HexagonEnums.td",
        "HexagonOps.td",
        "HexagonTypes.td",
    ],
    includes = ["/plugins/compiler"],
    deps = [
        "@iree//compiler/src/iree/compiler/Codegen/Dialect/Codegen/IR:td_files",
        "@llvm-project//mlir:DialectUtilsTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

iree_gentbl_cc_library(
    name = "HexagonDialectGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-dialect-decls"],
            "HexagonDialect.h.inc",
        ),
        (
            ["--gen-dialect-defs"],
            "HexagonDialect.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonDialect.td",
    deps = [":hexagon_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonEnumsGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            [
                "--gen-enum-decls",
                "--dialect=iree_hexagon",
            ],
            "HexagonEnums.h.inc",
        ),
        (
            [
                "--gen-enum-defs",
                "--dialect=iree_hexagon",
            ],
            "HexagonEnums.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonEnums.td",
    deps = [":hexagon_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonAttrsGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-attrdef-decls"],
            "HexagonAttrs.h.inc",
        ),
        (
            ["--gen-attrdef-defs"],
            "HexagonAttrs.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonAttrs.td",
    deps = [":hexagon_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonTypesGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-typedef-decls"],
            "HexagonTypes.h.inc",
        ),
        (
            ["--gen-typedef-defs"],
            "HexagonTypes.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonTypes.td",
    deps = [":hexagon_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonOpsGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-op-decls"],
            "HexagonOps.h.inc",
        ),
        (
            ["--gen-op-defs"],
            "HexagonOps.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonOps.td",
    deps = [":hexagon_td_files"],
)

cellar_hexagon_plugin_library(
    name = "HexagonIR",
    srcs = [
        "HexagonAttrs.cpp",
        "HexagonAttrs.cpp.inc",
        "HexagonDialect.cpp",
        "HexagonDialect.cpp.inc",
        "HexagonEnums.cpp.inc",
        "HexagonOps.cpp",
        "HexagonOps.cpp.inc",
        "HexagonTypes.cpp",
        "HexagonTypes.cpp.inc",
    ],
    hdrs = [
        "HexagonAttrs.h",
        "HexagonAttrs.h.inc",
        "HexagonDialect.h",
        "HexagonDialect.h.inc",
        "HexagonEnums.h.inc",
        "HexagonOps.h",
        "HexagonOps.h.inc",
        "HexagonTypes.h",
        "HexagonTypes.h.inc",
    ],
    hdr_deps = [
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:BytecodeOpInterface",
        "@llvm-project//mlir:Dialect",
        "@llvm-project//mlir:FunctionInterfaces",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:SideEffectInterfaces",
        "@llvm-project//mlir:Support",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [
        ":HexagonAttrsGen",
        ":HexagonDialectGen",
        ":HexagonEnumsGen",
        ":HexagonOpsGen",
        ":HexagonTypesGen",
    ],
)

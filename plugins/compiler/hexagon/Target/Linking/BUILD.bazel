load("//build_tools/bazel:defs.bzl", "hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

hexagon_plugin_library(
    name = "HexagonLinker",

load("@iree//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("@iree//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test", "iree_lit_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_COMMON_TOOLS = [
    "@iree//tools:iree-compile",
    "@iree//tools:iree-opt",
    "@llvm-project//lld:ld.lld",
    "@llvm-project//llvm:FileCheck",
    "@llvm-project//llvm:not",
]

iree_lit_test_suite(
    name = "lit",
    timeout = "short",
    srcs = enforce_glob(
        [
            "codegen/conversion/dispatch_config_legality.mlir",
            "codegen/conversion/lower_profiler_markers.mlir",
            "codegen/encoding/encoder_and_materializer_registration.mlir",
            "codegen/encoding/profiler_marker_ops.mlir",
            "codegen/pipelines/hexagon_lower_executable_target.mlir",
            "codegen/pipelines/hexagon_lower_executable_target_vtcm.mlir",
            "codegen/strategy/hexagon_dispatch_analysis_dimension_unification.mlir",
            "codegen/strategy/hexagon_dispatch_preflight.mlir",
            "codegen/strategy/hexagon_dispatch_preflight_existing_config_failure.mlir",
            "codegen/strategy/hexagon_plan_encoding_inner_parallel.mlir",
            "codegen/strategy/hexagon_plan_verification_last_tiling_anchor.mlir",
            "codegen/strategy/hexagon_root_tile_propagation.mlir",
            "codegen/strategy/hexagon_strategy_buffer_copy.mlir",
            "codegen/strategy/hexagon_strategy_contraction.mlir",
            "codegen/strategy/hexagon_strategy_convolution.mlir",
            "codegen/strategy/hexagon_strategy_default.mlir",
            "codegen/strategy/hexagon_strategy_generic.mlir",
            "codegen/strategy/hexagon_target_info.mlir",
            "codegen/strategy/hexagon_vtcm_planning.mlir",
            "codegen/strategy/hexagon_vtcm_planning_fallback.mlir",
            "codegen/transforms/apply_vtcm_tiling.mlir",
            "codegen/transforms/fold_dispatch_output_staging.mlir",
            "codegen/transforms/insert_profiler_markers.mlir",
            "codegen/transforms/lower_vtcm_staging.mlir",
            "codegen/transforms/promote_dma_tag_alloc_to_stack.mlir",
            "integration/32x32_matmul.mlir",
            "integration/4x4_matmul.mlir",
            "integration/attention_layer.mlir",
            "integration/encoding_resolver_generated_attribute.mlir",
            "target/executable_generation_and_dumping.mlir",
            "target/plugin_registration.mlir",
            "target/stack_frame_diagnostics.mlir",
            "target/stack_frame_transitive_calls.mlir",
            "target/target_attribute_embedding.mlir",
        ],
        include = [
            "codegen/conversion/*.mlir",
            "codegen/encoding/*.mlir",
            "codegen/pipelines/*.mlir",
            "codegen/strategy/*.mlir",
            "codegen/transforms/*.mlir",
            "target/*.mlir",
            "integration/*.mlir",
        ],
        exclude = [
            # These require the HMX matmul pipeline and its command-line flag.
            "codegen/strategy/hexagon_non_root_tile_selection.mlir",
            "codegen/strategy/hexagon_vtcm_planning_hmx.mlir",
            "codegen/strategy/hexagon_vtcm_planning_required.mlir",
            # Tested separately with target_compatible_with restriction because
            # they invoke `readelf`, which is only available on Linux.
            "target/native_runtime_linking_keeps_undefined_symbols.mlir",
            "target/query_function_generation_and_visibility.mlir",
            "target/shared_objects_have_correct_type.mlir",
        ],
    ),
    cfg = "//:lit.cfg.py",
    tools = _COMMON_TOOLS,
)

# These tests use `readelf`, which is only available on Linux in our CI
iree_lit_test(
    name = "target/native_runtime_linking_keeps_undefined_symbols.mlir.test",
    timeout = "short",
    cfg = "//:lit.cfg.py",
    target_compatible_with = ["@platforms//os:linux"],
    test_file = "target/native_runtime_linking_keeps_undefined_symbols.mlir",
    tools = _COMMON_TOOLS,
)

iree_lit_test(
    name = "target/query_function_generation_and_visibility.mlir.test",
    timeout = "short",
    cfg = "//:lit.cfg.py",
    target_compatible_with = ["@platforms//os:linux"],
    test_file = "target/query_function_generation_and_visibility.mlir",
    tools = _COMMON_TOOLS,
)

iree_lit_test(
    name = "target/shared_objects_have_correct_type.mlir.test",
    timeout = "short",
    cfg = "//:lit.cfg.py",
    target_compatible_with = ["@platforms//os:linux"],
    test_file = "target/shared_objects_have_correct_type.mlir",
    tools = _COMMON_TOOLS,
)

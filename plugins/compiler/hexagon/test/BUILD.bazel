# These tests use `readelf`, which is only available on Linux in our CI
iree_lit_test(
    name = "target/native_runtime_linking_keeps_undefined_symbols.mlir.test",
    timeout = "short",
    cfg = "//:lit.cfg.py",
    target_compatible_with = ["@platforms//os:linux"],
    test_file = "target/native_runtime_linking_keeps_undefined_symbols.mlir",
    tools = _COMMON_TOOLS,
)

iree_lit_test(
    name = "target/query_function_generation_and_visibility.mlir.test",
    timeout = "short",
    cfg = "//:lit.cfg.py",
    target_compatible_with = ["@platforms//os:linux"],

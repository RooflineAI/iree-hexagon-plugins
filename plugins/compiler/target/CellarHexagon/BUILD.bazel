        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:ToLLVMIRTranslation",
        "@patio//target/CellarHexagon/CodeGen",
        "@patio//target/CellarHexagon/CodeGen:HexagonEncodingExternalModels",
        "@patio//target/CellarHexagon/CodeGen:HexagonLinkerTool",
        "@patio//target/CellarHexagon/CodeGen/IR:HexagonEncodingIR",

    deps = [
        "@iree//compiler/plugins/target/LLVMCPU:LLVMTargetOptions",
        "@iree//compiler/plugins/target/LLVMCPU:LinkerTool",
        "@iree//compiler/src/iree/compiler/Codegen/Dialect/CPU/IR:IREECPUDialect",
        "@iree//compiler/src/iree/compiler/Codegen/Utils",
        "@iree//compiler/src/iree/compiler/Dialect/Encoding/IR",
        "@iree//compiler/src/iree/compiler/Dialect/HAL/Target",
        "@iree//compiler/src/iree/compiler/PluginAPI",
        "@iree//compiler/src/iree/compiler/Utils",
        "@llvm-project//llvm:BitWriter",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:HexagonAsmParser",
        "@llvm-project//llvm:HexagonCodeGen",
        "@llvm-project//llvm:HexagonDisassembler",
        "@llvm-project//llvm:HexagonInfo",
        "@llvm-project//llvm:HexagonUtilsAndDesc",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:Passes",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",

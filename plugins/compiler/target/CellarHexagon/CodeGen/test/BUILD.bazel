load("@iree//build_tools/bazel:enforce_glob.bzl", "enforce_glob")
load("@iree//build_tools/bazel:iree_lit_test.bzl", "iree_lit_test_suite")

package(
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_lit_test_suite(
    name = "lit",
    srcs = enforce_glob(
        [
            "check_correct_plugin_registration.mlir",
            "check_encoder_and_materializer_registration.mlir",
            "check_executable_generation_and_ll_dumping.mlir",
            "check_target_attribute_embedding.mlir",
            "check_shared_objects_have_correct_type.mlir",
        ],
        include = ["*.mlir"],
    ),
    cfg = "//:lit.cfg.py",
    tools = [
        "@iree//tools:iree-compile",
        "@iree//tools:iree-opt",
        "@llvm-project//lld:ld.lld",
        "@llvm-project//llvm:FileCheck",
        "@llvm-project//llvm:not",
    ],
)

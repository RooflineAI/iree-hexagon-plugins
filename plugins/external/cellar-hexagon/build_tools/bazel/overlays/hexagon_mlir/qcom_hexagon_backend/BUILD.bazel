load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Please add stable targets combining those from subdirectories here

alias(
    name = "runtime_lib",
    actual = "@hexagon-mlir//qcom_hexagon_backend/bin/runtime:runtime_lib",
)

cc_library(
    name = "HexagonDialects",
    deps = [
        "@hexagon-mlir//qcom_hexagon_backend/lib/Common:HexagonCommon",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Dialect/HexKL/IR:HexKL",
        "@hexagon-mlir//qcom_hexagon_backend/lib/Dialect/HexagonMem/IR:HexagonMem",
    ],
)

cc_library(
    name = "HexagonPassesIncGen",
    deps = [
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:AffineToLLVMConversionPassIncGen",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:DMAToLLVMConversionPassIncGen",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:HexKLToLLVMConversionPassIncGen",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:HexagonMemToLLVMConversionPassIncGen",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:LinalgToLLVMConversionPassIncGen",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:TransformsPassIncGen",
    ],
)

cc_library(
    name = "HexagonCodegenHeaders",
    deps = [
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:ConversionHeadersLib",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:TransformsHeadersLib",
    ],
)

cc_library(
    name = "HexKLToLLVMCodegen",
    deps = [
        ":HexagonCodegenHeaders",
        ":HexagonDialects",
        ":HexagonPassesIncGen",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:HexKLHeadersLib",
        "@hexagon-mlir//qcom_hexagon_backend/include/hexagon:HexagonMemHeadersLib",
    ],
)

cc_library(
    name = "HexagonBackend",
    deps = [
        ":HexKLToLLVMCodegen",
    ],
)

load("//build_tools/bazel:defs.bzl", "cellar_hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cellar_hexagon_plugin_library(
    name = "registration",
    srcs = [
        "HexagonTarget.cpp",
    ],
    hdrs = [],
    hdr_deps = [
        "@iree//compiler/plugins/target/LLVMCPU",
        "@iree//compiler/plugins/target/LLVMCPU:LLVMTargetOptions",
        "@iree//compiler/plugins/target/LLVMCPU:LinkerTool",
        "@iree//compiler/src/iree/compiler/Codegen/Dialect/CPU/IR:IREECPUDialect",
        "@iree//compiler/src/iree/compiler/Codegen/Utils",
        "@iree//compiler/src/iree/compiler/Dialect/Encoding/IR",
        "@iree//compiler/src/iree/compiler/Dialect/HAL/Target",
        "@iree//compiler/src/iree/compiler/PluginAPI",
        "@iree//compiler/src/iree/compiler/Utils",
        "@llvm-project//llvm:BitWriter",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:Passes",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:TargetParser",
        "@llvm-project//llvm:TransformUtils",
        "@llvm-project//mlir:BuiltinToLLVMIRTranslation",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:LLVMToLLVMIRTranslation",
        "@llvm-project//mlir:Parser",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:ToLLVMIRTranslation",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [
        "//plugins/compiler/cellar-hexagon/CodeGen",
        "//plugins/compiler/cellar-hexagon/CodeGen:HexagonEncodingExternalModels",
        "//plugins/compiler/cellar-hexagon/CodeGen:HexagonLinkerTool",
        "//plugins/compiler/cellar-hexagon/CodeGen/IR:HexagonEncodingIR",
        "@hexagon-mlir//qcom_hexagon_backend:HexagonDialectLibs",
        # These dependencies are not present in the base iree-compile binary,
        # so they need to be added with the dynamic plugin
        "@llvm-project//mlir:ArithTransforms",
        "@llvm-project//mlir:MemRefTransforms",
        "@llvm-project//mlir:SCFTransforms",
    ],
)

        "@iree//compiler/src/iree/compiler/Dialect/Encoding/Utils",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [
        "//plugins/compiler/cellar-hexagon/CodeGen/IR:HexagonIR",
    ],
)

iree_gentbl_cc_library(
    name = "PassesIncGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-pass-decls"],
            "Passes.h.inc",

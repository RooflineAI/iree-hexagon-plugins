load("@iree//build_tools/bazel:build_defs.oss.bzl", "iree_gentbl_cc_library")
load("//build_tools/bazel:defs.bzl", "cellar_hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cellar_hexagon_plugin_library(
    name = "HexagonEncodingExternalModels",
    srcs = [
        "Encoding/HexagonEncodingExternalModels.cpp",
    ],
    hdrs = [
        "Encoding/HexagonEncodingExternalModels.h",
    ],
    hdr_deps = [
        "@iree//compiler/src/iree/compiler/Codegen/Dialect/Codegen/IR:IREECodegenDialect",
        "@iree//compiler/src/iree/compiler/Codegen/Dialect/Codegen/Utils",

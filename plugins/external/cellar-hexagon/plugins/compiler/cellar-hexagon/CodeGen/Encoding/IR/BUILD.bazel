load(
    "@iree//build_tools/bazel:build_defs.oss.bzl",
    "iree_gentbl_cc_library",
    "iree_td_library",
)
load("//build_tools/bazel:defs.bzl", "cellar_hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_td_library(
    name = "hexagon_encoding_td_files",
    srcs = [
        "HexagonEncodingAttrs.td",
        "HexagonEncodingDialect.td",
        "HexagonEncodingOps.td",
        "HexagonEncodingTypes.td",
    ],
    includes = ["/plugins/compiler"],
    deps = [
        "@iree//compiler/src/iree/compiler/Codegen/Dialect/Codegen/IR:td_files",
        "@llvm-project//mlir:DialectUtilsTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

iree_gentbl_cc_library(
    name = "HexagonEncodingDialectGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-dialect-decls"],
            "HexagonEncodingDialect.h.inc",
        ),
        (
            ["--gen-dialect-defs"],
            "HexagonEncodingDialect.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonEncodingDialect.td",
    deps = [":hexagon_encoding_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonEncodingOpsGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-op-decls"],
            "HexagonEncodingOps.h.inc",
        ),
        (
            ["--gen-op-defs"],
            "HexagonEncodingOps.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonEncodingOps.td",
    deps = [":hexagon_encoding_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonEncodingTypesGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-typedef-decls"],
            "HexagonEncodingTypes.h.inc",
        ),
        (
            ["--gen-typedef-defs"],
            "HexagonEncodingTypes.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonEncodingTypes.td",
    deps = [":hexagon_encoding_td_files"],
)

iree_gentbl_cc_library(
    name = "HexagonEncodingAttrsGen",
    strip_include_prefix = "/plugins/compiler",
    tbl_outs = [
        (
            ["--gen-attrdef-decls"],
            "HexagonEncodingAttrs.h.inc",
        ),
        (
            ["--gen-attrdef-defs"],
            "HexagonEncodingAttrs.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "HexagonEncodingAttrs.td",
    deps = [":hexagon_encoding_td_files"],
)

cellar_hexagon_plugin_library(
    name = "HexagonEncodingIR",
    srcs = [
        "HexagonEncodingAttrs.cpp",
        "HexagonEncodingAttrs.cpp.inc",
        "HexagonEncodingDialect.cpp",
        "HexagonEncodingDialect.cpp.inc",
        "HexagonEncodingOps.cpp",
        "HexagonEncodingOps.cpp.inc",
        "HexagonEncodingTypes.cpp",
        "HexagonEncodingTypes.cpp.inc",
    ],
    hdrs = [
        "HexagonEncodingAttrs.h",
        "HexagonEncodingAttrs.h.inc",
        "HexagonEncodingDialect.h",
        "HexagonEncodingDialect.h.inc",
        "HexagonEncodingOps.h",
        "HexagonEncodingOps.h.inc",
        "HexagonEncodingTypes.h",
        "HexagonEncodingTypes.h.inc",
    ],
    hdr_deps = [
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:BytecodeOpInterface",
        "@llvm-project//mlir:Dialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:SideEffectInterfaces",
        "@llvm-project//mlir:Support",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [
        ":HexagonEncodingAttrsGen",
        ":HexagonEncodingDialectGen",
        ":HexagonEncodingOpsGen",
        ":HexagonEncodingTypesGen",
    ],
)

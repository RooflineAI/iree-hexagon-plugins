load("//build_tools/bazel:defs.bzl", "cellar_hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cellar_hexagon_plugin_library(
    name = "HexagonOptions",
    srcs = [
        "HexagonOptions.cpp",
    ],
    hdrs = [
        "HexagonOptions.h",
    ],
    hdr_deps = [
        "@iree//compiler/src/iree/compiler/Utils",
        "@llvm-project//llvm:Support",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [],
)

cellar_hexagon_plugin_library(
    name = "HexagonLLVMTarget",
    srcs = [
        "HexagonLLVMTarget.cpp",
    ],
    hdrs = [
        "HexagonLLVMTarget.h",
    ],
    hdr_deps = [
        "@iree//compiler/plugins/target/LLVMCPU:LLVMTargetOptions",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [
        ":HexagonOptions",
    ],
)

cellar_hexagon_plugin_library(
    name = "HexagonTargetDevice",
    srcs = [
        "HexagonTargetDevice.cpp",
    ],
    hdrs = [
        "HexagonTargetDevice.h",
    ],
    hdr_deps = [
        "@iree//compiler/src/iree/compiler/Dialect/HAL/Target",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Support",
    ],
    strip_include_prefix = "/plugins/compiler",
    deps = [
        ":HexagonOptions",
    ],
)

cellar_hexagon_plugin_library(
    name = "HexagonExecutableSerialization",

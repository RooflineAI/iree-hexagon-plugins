load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load(
    "//build_tools/bazel:platform_aliases.bzl",
    "aarch64_android_platform_alias",
    "aarch64_android_tracy_platform_alias",
)
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:pkg.bzl", "pkg_zip")
load("//build_tools/bazel:defs.bzl", "hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = [],
)

config_setting(
    name = "hexagon_runtime_enabled",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

hexagon_plugin_library(
    name = "hexagon",
    srcs = [
        "allocator.c",
        "allocator.h",
        "buffer.c",
        "buffer.h",
        "channel.c",
        "channel.h",
        "command_buffer.c",
        "command_buffer.h",
        "device.c",
        "device.h",
        "driver.c",
        "driver.h",
        "event.c",
        "event.h",
        "executable.c",
        "executable.h",
        "executable_cache.c",
        "executable_cache.h",
        "mem_alloc.c",
        "mem_alloc.h",
        "profiler.c",
        "profiler.h",
        "rpc_types.c",
        "semaphore.c",
        "semaphore.h",
        "utils.c",
        "utils.h",
    ],
    hdrs = [
        "api.h",
    ],
    defines = select({
        "@iree//runtime/src/iree/base/tracing:_tracy_enable": [
            "IREE_HAL_HEXAGON_ENABLE_PROFILER",
            "IREE_TRACING_EXPERIMENTAL_CONTEXT_API=1",
        ],
        "//conditions:default": [],
    }),
    hdr_deps = [],
    strip_include_prefix = "/plugins/runtime",
    deps = [
        "//plugins/runtime/hexagon/arm_dsp:hexagon_arm_dsp",
        "//plugins/runtime/hexagon/interface:hexagon_dsp_stub_lib",
        "//plugins/runtime/hexagon/schemas:hexagon_executable_def_c_fbs",
        "//plugins/runtime/hexagon/serialize:serialize_plugin",
        # Statically linked directly into iree-run-module/iree-benchmark-module
        # now (see build_tools/bazel/load_external_hal_drivers.bzl) - these were
        # previously hdr_deps (declarations only), relying on the dynamically
        # loaded plugin .so's host process already linking in the real
        # implementations. That assumption no longer holds now that there's no
        # separate process boundary, so they need to be real deps.
        "@iree//runtime/src/iree/async",
        "@iree//runtime/src/iree/async/util:proactor_pool",
        "@iree//runtime/src/iree/base",
        "@iree//runtime/src/iree/base/internal",
        "@iree//runtime/src/iree/base/internal/flatcc:building",
        "@iree//runtime/src/iree/base/internal/flatcc:parsing",
        "@iree//runtime/src/iree/hal",
        "@iree//runtime/src/iree/hal/utils:executable_header",
        "@iree//runtime/src/iree/hal/utils:file_transfer",
        "@iree//runtime/src/iree/hal/utils:files",
        "@iree//runtime/src/iree/hal/utils:queue_emulation",
        "@iree//runtime/src/iree/hal/utils:queue_host_call_emulation",
        "@iree//runtime/src/iree/hal/utils:resource_set",
    ],
)

pkg_files(
    name = "hexagon_runtime_bin_files",
    srcs = [
        "@iree//tools:iree-benchmark-module",
        "@iree//tools:iree-run-module",
    ],
    prefix = "bin",
)

pkg_files(
    name = "hexagon_runtime_lib_files",
    srcs = ["@android_ndk_detect//:libcxx_shared"],
    prefix = "lib",
)

pkg_files(
    name = "hexagon_runtime_hexagon_lib_files",
    srcs = ["//plugins/runtime/hexagon/dsp:hexagon_dsp_skel_out"],
    prefix = "lib/hexagon",
)

pkg_zip(
    name = "hexagon_runtime",
    srcs = [
        ":hexagon_runtime_bin_files",
        ":hexagon_runtime_hexagon_lib_files",
        ":hexagon_runtime_lib_files",
    ],
    package_dir = ".",
    visibility = ["//visibility:public"],
)

# Provide a platform alias for Android aarch64 here for integration tests
# that run onLinux x86_64, but need the Hexagon runtime package built for
# Android aarch64 to push it to an Android phone and run it there.
aarch64_android_platform_alias(
    name = "hexagon_runtime_aarch64_android_internal",
    actual = ":hexagon_runtime",
    target_compatible_with = select({
        "@android_ndk_detect//:android_ndk_available": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# The runtime package built with IREE tracing set to tracy (profiler enabled).
# Points at :hexagon_runtime so the produced runfile is hexagon_runtime.zip (the
# fixed path hexagon_rt.data_files.get_hexagon_runtime() resolves); the
# transition applies the tracy config to its contents.
aarch64_android_tracy_platform_alias(
    name = "hexagon_runtime_aarch64_android_tracy_internal",
    actual = ":hexagon_runtime",
    target_compatible_with = select({
        "@android_ndk_detect//:android_ndk_available": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Both aliases above produce a same-named hexagon_runtime.zip, just under
# separate config-specific output trees (one per transition), so building
# both at once doesn't let you tell them apart by path. Copy each into the
# default configuration under a distinct name so both are available
# side by side for local comparison/testing.
copy_file(
    name = "hexagon_runtime_aarch64_android",
    src = ":hexagon_runtime_aarch64_android_internal",
    out = "hexagon_runtime_aarch64_android.zip",
    target_compatible_with = select({
        "@android_ndk_detect//:android_ndk_available": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

copy_file(
    name = "hexagon_runtime_aarch64_android_tracy",
    src = ":hexagon_runtime_aarch64_android_tracy_internal",
    out = "hexagon_runtime_aarch64_android_tracy.zip",
    target_compatible_with = select({
        "@android_ndk_detect//:android_ndk_available": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

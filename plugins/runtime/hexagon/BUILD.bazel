load("@iree//build_tools/bazel:build_defs.oss.bzl", "iree_runtime_cc_library")
load("@roof_mlir//:build_tools/bazel/platform_aliases.bzl", "aarch64_android_platform_alias")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:pkg.bzl", "pkg_zip")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = [],
)

config_setting(
    name = "hexagon_runtime_enabled",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

iree_runtime_cc_library(
    name = "hexagon",
    srcs = [
        "allocator.c",
        "allocator.h",
        "buffer.c",
        "buffer.h",
        "channel.c",
        "channel.h",
        "command_buffer.c",
        "command_buffer.h",
        "device.c",
        "device.h",
        "driver.c",
        "driver.h",
        "event.c",
        "event.h",
        "executable.c",
        "executable.h",
        "executable_cache.c",
        "executable_cache.h",
        "mem_alloc.c",
        "mem_alloc.h",
        "rpc_types.c",
        "semaphore.c",
        "semaphore.h",
        "utils.c",
        "utils.h",
    ],
    hdrs = [
        "api.h",
    ],
    data = [
        "//hexagon/dsp:hexagon_dsp_skel_out",
    ],
    deps = [
        "//hexagon/arm_dsp:hexagon_arm_dsp",
        "//hexagon/interface:hexagon_dsp_stub_lib",
        "//hexagon/serialize",
        "@hexagon_sdk//:cdsprpc_android_aarch64",
        "@iree//runtime/src/iree/base",
        "@iree//runtime/src/iree/base/internal",
        "@iree//runtime/src/iree/base/internal:event_pool",
        "@iree//runtime/src/iree/hal",
        "@iree//runtime/src/iree/hal/utils:file_transfer",
        "@iree//runtime/src/iree/hal/utils:files",
        "@iree//runtime/src/iree/hal/utils:queue_emulation",
        "@iree//runtime/src/iree/hal/utils:queue_host_call_emulation",
        "@iree//runtime/src/iree/hal/utils:resource_set",
        "@iree//runtime/src/iree/hal/utils:semaphore_base",
    ],
)

# The .farf file contains flags (as value in hex) controlling the debug output
# from the Hexagon core. 0x1f means to enable all 5 flags.
pkg_files(
    name = "hexagon_runtime_bin_files",
    srcs = [
        "iree-run-module.farf",
        "@iree//tools:iree-run-module",
    ],
    prefix = "bin",
)

pkg_files(
    name = "hexagon_runtime_lib_files",
    srcs = ["@android_ndk_sysroot//:libcxx_shared"],
    prefix = "lib",
)

pkg_files(
    name = "hexagon_runtime_hexagon_lib_files",
    srcs = ["//hexagon/dsp:hexagon_dsp_skel_out"],
    prefix = "lib/hexagon",
)

pkg_zip(
    name = "hexagon_runtime",
    srcs = [
        ":hexagon_runtime_bin_files",
        ":hexagon_runtime_hexagon_lib_files",
        ":hexagon_runtime_lib_files",
    ],
    package_dir = ".",
    visibility = ["//visibility:public"],
)

# Provide a platform alias for Android aarch64 here for integration tests
# that run onLinux x86_64, but need the Hexagon runtime package built for
# Android aarch64 to push it to an Android phone and run it there.
aarch64_android_platform_alias(
    name = "hexagon_runtime_aarch64_android",
    actual = ":hexagon_runtime",
)

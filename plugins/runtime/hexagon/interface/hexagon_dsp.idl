#include "AEEStdDef.idl"
#include "remote.idl"

const string IDL_VERSION = "1.2.3";

interface hexagon_dsp : remote_handle64 {
   long executable_load(in string name, rout long long executable_handle);
   long executable_close(in long long executable_handle);
   long command_buffer_create(in sequence<uint8> cmd_buf, rout long long command_buffer_handle);
   long command_buffer_destroy(in long long command_buffer_handle);
};

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//build_tools/bazel:defs.bzl", "hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = [],
)

hexagon_plugin_library(
    name = "DriverModuleLib",
    srcs = ["driver_module.c"],
    hdrs = ["driver_module.h"],
    hdr_deps = [
        "@iree//runtime/src/iree/base",
        "@iree//runtime/src/iree/base/tooling:flags",
        "@iree//runtime/src/iree/hal",
    ],
    deps = [
        "//plugins/runtime/hexagon",
    ],
)

# Static registration into iree-run-module/iree-benchmark-module (see
# build_tools/bazel/load_external_hal_drivers.bzl): additionally links the
# IREE runtime libraries the driver uses header-only. A dynamically loaded
# HAL plugin links :DriverModuleLib alone instead.
cc_library(
    name = "DriverModuleStaticLib",
    deps = [
        ":DriverModuleLib",
        "//plugins/runtime/hexagon:iree_runtime_libs",
    ],
)

# Dynamically loadable HAL driver, packaged as lib/libiree_hal_hexagon.so in
# the runtime zip (see //plugins/runtime/hexagon:hexagon_runtime_lib_files):
#   IREE_DYNAMIC_HAL=hexagon=/path/libiree_hal_hexagon.so iree-run-module ...
# Uses IREE header-only (see :DriverModuleLib); the IREE runtime symbols come
# from the loading program, which must export them (-Wl,--export-dynamic).
cc_binary(
    name = "iree_hal_hexagon",
    # The IREE runtime symbols stay undefined until the loading program
    # provides them.
    features = ["allow_all_undefined_symbols"],
    # Keep the entry point IREE looks up via dlsym, although nothing in the
    # shared object references it.
    linkopts = ["-Wl,-u,iree_hal_hexagon_driver_module_register"],
    linkshared = True,
    target_compatible_with = select({
        "//plugins/runtime/hexagon:hexagon_runtime_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":DriverModuleLib"],
)

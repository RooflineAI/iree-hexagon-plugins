load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//build_tools/bazel:defs.bzl", "hexagon_plugin_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = [],
)

hexagon_plugin_library(
    name = "DriverModuleLib",
    srcs = ["driver_module.c"],
    hdrs = ["driver_module.h"],
    hdr_deps = [
        "@iree//runtime/src/iree/base",
        "@iree//runtime/src/iree/base/tooling:flags",
        "@iree//runtime/src/iree/hal",
    ],
    deps = [
        "//plugins/runtime/hexagon",
    ],
)

# Static registration into iree-run-module/iree-benchmark-module (see
# build_tools/bazel/load_external_hal_drivers.bzl): additionally links the
# IREE runtime libraries the driver uses header-only. A dynamically loaded
# HAL plugin links :DriverModuleLib alone instead.
cc_library(
    name = "DriverModuleStaticLib",
    deps = [
        ":DriverModuleLib",
        "//plugins/runtime/hexagon:iree_runtime_libs",
    ],
)
